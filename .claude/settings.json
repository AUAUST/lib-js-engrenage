{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.[^e]*)",
      "Read(**/.env.e[^x]*)",
      "mcp__Claude_Browser",
      "mcp__Claude_Code_iOS_Simulator",
      "mcp__claude-in-chrome",
      "mcp__visualize",
      "mcp__scheduled-tasks",
      "mcp__mcp-registry",
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "DesignSync",
      "NotebookEdit",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(LEFTHOOK=0 *)",
      "Bash(LEFTHOOK=false *)",
      "Bash(git config core.hooksPath*)"
    ],
    "allow": ["Bash(gh api *issue-field-values*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook github",
            "if": "Bash(gh issue create *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook github",
            "if": "Bash(gh issue edit *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook github",
            "if": "Bash(gh issue comment *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook git",
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook git",
            "if": "Bash(git -c *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook git",
            "if": "Bash(git -C *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook git",
            "if": "Bash(git config *)"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook dispatch",
            "if": "Agent(worker)"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --silent engrenage agents claude hook dispatch",
            "if": "Agent(debugger)"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
