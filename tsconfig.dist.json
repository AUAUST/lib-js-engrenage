{
  "extends": "./tsconfig.tests.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "paths": {},
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.dist.tsbuildinfo",
    "skipLibCheck": false,
    "target": "ES2025",
    "lib": [
      "ES2025"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "env.d.ts"
  ],
  "exclude": [
    "tests/**/fixtures/**"
  ]
}
