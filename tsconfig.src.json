{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "env.d.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.src.tsbuildinfo",
    "target": "ES2024",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2023.Intl",
      "ES2024.Collection",
      "ES2024.Object",
      "ES2024.Promise",
      "ES2024.Regexp",
      "ES2024.String"
    ],
    "types": []
  }
}
