{
  "extends": "./tsconfig.tests.json",
  "compilerOptions": {
    "paths": {},
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.tests.dist.tsbuildinfo",
    "skipLibCheck": false,
    "incremental": true
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/**/*.test.mts",
    "tests/**/*.test.cts",
    "tests/**/*.test.dist.ts",
    "tests/**/*.test.dist.mts",
    "tests/**/*.test.dist.cts",
    "tests/setup.ts",
    "tests/**/*.d.ts",
    "global.d.ts"
  ]
}
