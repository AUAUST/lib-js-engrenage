{
  "extends": "./tsconfig.tests.json",
  "compilerOptions": {
    "paths": {},
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.tests.dist.tsbuildinfo",
    "skipLibCheck": false,
    "exactOptionalPropertyTypes": false,
    "incremental": true
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tests/**/*.test.dist.ts",
    "tests/**/*.test.dist.tsx",
    "tests/setup.ts",
    "tests/*.d.ts",
    "env.d.ts"
  ]
}
