{
  "name": "@auaust/engrenage",
  "version": "0.4.2",
  "description": "Shared configurations and tooling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AUAUST/lib-js-engrenage.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "type": "module",
  "bin": {
    "engrenage": "./dist/bin/engrenage.mjs"
  },
  "scripts": {
    "build": "pnpm run engrenage tsdown && pnpm run engrenage typecheck:dist && pnpm run engrenage vitest:dist",
    "ci": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "ci:build": "pnpm run build",
    "ci:check": "pnpm run engrenage sync --check && pnpm run support codegen barrels --check && pnpm run support codegen rules --check && pnpm run typecheck && pnpm run lint",
    "ci:publish": "changeset publish",
    "ci:test": "pnpm run engrenage vitest",
    "coverage": "pnpm run engrenage vitest:coverage",
    "engrenage": "node bin/engrenage/index.ts",
    "format": "pnpm run engrenage prettier",
    "format:all": "pnpm run engrenage prettier:all",
    "lint": "pnpm run engrenage eslint",
    "lint:check": "pnpm run engrenage eslint",
    "lint:fix": "pnpm run engrenage eslint:fix",
    "lint:suppress": "pnpm run engrenage eslint:suppress",
    "ready": "pnpm install --frozen-lockfile && pnpm run support codegen rules && pnpm run support codegen barrels && pnpm run engrenage sync && pnpm run ci && echo 'Ready!'",
    "support": "node scripts/support/index.ts",
    "test": "pnpm run engrenage vitest && pnpm run engrenage typecheck",
    "typecheck": "pnpm run engrenage typecheck",
    "typecheck:dist": "pnpm run engrenage typecheck:dist",
    "watch": "pnpm run engrenage vitest:watch"
  },
  "imports": {
    "#agents/*": "./src/agents/*.ts",
    "#bin/*": "./bin/*.ts",
    "#changesets/*": "./src/changesets/*.ts",
    "#config/*": "./src/config/*.ts",
    "#constants": "./src/constants.ts",
    "#eslint/*": "./src/eslint/*.ts",
    "#git/*": "./src/git/*.ts",
    "#github/*": "./src/github/*.ts",
    "#package.json": "./package.json",
    "#pnpm/*": "./src/pnpm/*.ts",
    "#prettier": "./src/prettier/index.ts",
    "#prettier/*": "./src/prettier/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#support/*": "./src/support/*.ts",
    "#tests/*": "./tests/*.ts",
    "#tsdown/*": "./src/tsdown/*.ts",
    "#types/*": "./src/types/*.ts",
    "#typescript/*": "./src/typescript/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#vite/*": "./src/vite/*.ts",
    "#vitest/*": "./src/vitest/*.ts",
    "#vscode/*": "./src/vscode/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./agents": "./dist/agents/index.mjs",
    "./agents/claude": "./dist/agents/claude/index.mjs",
    "./agents/claude/constants": "./dist/agents/claude/constants.mjs",
    "./agents/codex": "./dist/agents/codex/index.mjs",
    "./agents/codex/constants": "./dist/agents/codex/constants.mjs",
    "./agents/constants": "./dist/agents/constants.mjs",
    "./changesets": "./dist/changesets/index.mjs",
    "./changesets/constants": "./dist/changesets/constants.mjs",
    "./config": "./dist/config/index.mjs",
    "./config/constants": "./dist/config/constants.mjs",
    "./constants": "./dist/constants.mjs",
    "./eslint": "./dist/eslint/index.mjs",
    "./eslint/constants": "./dist/eslint/constants.mjs",
    "./git": "./dist/git/index.mjs",
    "./git/constants": "./dist/git/constants.mjs",
    "./github": "./dist/github/index.mjs",
    "./github/constants": "./dist/github/constants.mjs",
    "./pnpm": "./dist/pnpm/index.mjs",
    "./pnpm/constants": "./dist/pnpm/constants.mjs",
    "./prettier": "./dist/prettier/index.mjs",
    "./prettier/constants": "./dist/prettier/constants.mjs",
    "./tsdown": "./dist/tsdown/index.mjs",
    "./tsdown/constants": "./dist/tsdown/constants.mjs",
    "./typescript": "./dist/typescript/index.mjs",
    "./typescript/constants": "./dist/typescript/constants.mjs",
    "./vite": "./dist/vite/index.mjs",
    "./vitest": "./dist/vitest/index.mjs",
    "./vitest/constants": "./dist/vitest/constants.mjs",
    "./vscode": "./dist/vscode/index.mjs",
    "./vscode/constants": "./dist/vscode/constants.mjs",
    "./agents/templates/*.md": "./data/agents/templates/*.md",
    "./agents/rules/*.md": "./data/agents/rules/*.md",
    "./agents/sections/*.md": "./data/agents/sections/*.md",
    "./github/workflows/*.yml": "./data/github/workflows/*.yml",
    "./tsconfig/*.json": "./data/tsconfig/*.json"
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c12": "4.0.0-rc.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.11.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@auaust/primitive-kit": "^0.42.2",
    "@auaust/toolkit": "^0.5.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "commander": "~15.0.0",
    "eslint": "^10.13.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@changesets/cli": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@auaust/primitive-kit": "0.42.2",
    "@auaust/toolkit": "0.5.1",
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "fast-string-truncated-width": "3.0.3",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "jsonc-parser": "3.3.1",
    "sisteransi": "1.0.5"
  },
  "sideEffects": false,
  "prettier": "#prettier",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
