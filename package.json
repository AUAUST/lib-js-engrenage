{
  "name": "@auaust/engrenage",
  "license": "GPL-3.0-only",
  "type": "module",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared configurations and tooling.",
  "sideEffects": false,
  "prettier": "#prettier",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "repository": {
    "url": "git+https://github.com/AUAUST/lib-js-engrenage.git"
  },
  "imports": {
    "#agents/*": "./src/agents/*.ts",
    "#bin/*": "./bin/*.ts",
    "#eslint/*": "./src/eslint/*.ts",
    "#prettier": "./src/prettier/index.ts",
    "#prettier/*": "./src/prettier/*.ts",
    "#support/*": "./src/support/*.ts",
    "#types/*": "./src/types/*.ts",
    "#typescript/*": "./src/typescript/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#vite/*": "./src/vite/*.ts"
  },
  "bin": {
    "engrenage": "./dist/bin/engrenage.mjs"
  },
  "scripts": {
    "build": "pnpm run build:tsdown && tsc --noEmit --project tsconfig.dist.json && vitest run --config vitest.config.ts --typecheck --mode build --",
    "build:tsdown": "tsdown --config-loader tsx",
    "coverage": "vitest run --coverage",
    "engrenage": "node bin/engrenage/index.ts",
    "format": "prettier --write --ignore-unknown",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vitest run --config vitest.config.ts --typecheck -- && pnpm run typecheck",
    "typecheck": "echo 'Typechecking...' && tsc --noEmit && echo 'All good!'",
    "watch": "vitest --config vitest.config.ts --typecheck --",
    "ci:prepare": "pnpm run typecheck && pnpm run lint && pnpm run engrenage agents sync --check && pnpm run build",
    "ci:publish": "changeset publish"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "typescript-eslint": "^8.72.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@auaust/primitive-kit": "^0.42.2",
    "@auaust/toolkit": "^0.5.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commander-js/extra-typings": "^15.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "commander": "~15.0.0",
    "eslint": "^10.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "inlinedDependencies": {
    "@auaust/primitive-kit": "0.42.2",
    "@auaust/toolkit": "0.5.1",
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./agents": "./dist/agents/index.mjs",
    "./eslint": "./dist/eslint/index.mjs",
    "./prettier": "./dist/prettier/index.mjs",
    "./typescript": "./dist/typescript/index.mjs",
    "./vite": "./dist/vite/index.mjs",
    "./agents/rules/*.md": "./src/agents/presets/rules/*.md",
    "./agents/sections/*.md": "./src/agents/presets/sections/*.md",
    "./typescript/presets/*.json": "./src/typescript/presets/*.json"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
