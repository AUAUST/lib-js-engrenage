{
  "name": "@auaust/engrenage",
  "version": "0.7.0",
  "description": "Shared configurations and tooling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AUAUST/lib-js-engrenage.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Aurian Aubert",
    "email": "aurian@auaust.ch",
    "url": "https://auaust.ch"
  },
  "type": "module",
  "bin": {
    "engrenage": "./dist/bin/engrenage.mjs"
  },
  "scripts": {
    "build": "pnpm run engrenage tsdown && pnpm run engrenage typecheck:dist && pnpm run engrenage vitest:dist",
    "ci": "pnpm run ci:check && pnpm run ci:test && pnpm run ci:build",
    "ci:build": "pnpm run build",
    "ci:check": "pnpm run engrenage sync --check && pnpm run engrenage structure --check && pnpm run support codegen --check && pnpm run support pnpm --check && pnpm run engrenage prettier:check . && pnpm run typecheck && pnpm run lint --no-cache",
    "ci:publish": "changeset publish",
    "ci:test": "pnpm run engrenage vitest",
    "coverage": "pnpm run engrenage vitest:coverage",
    "engrenage": "node bin/engrenage/index.ts",
    "format": "pnpm run engrenage prettier",
    "format:all": "pnpm run engrenage prettier:all",
    "lint": "pnpm run engrenage eslint",
    "lint:check": "pnpm run engrenage eslint",
    "lint:fix": "pnpm run engrenage eslint:fix",
    "lint:suppress": "pnpm run engrenage eslint:suppress",
    "prepare": "lefthook install",
    "ready": "pnpm install --frozen-lockfile && pnpm run support codegen && pnpm run engrenage sync && pnpm run ci && echo 'Ready!'",
    "support": "node scripts/index.ts",
    "test": "pnpm run engrenage vitest && pnpm run engrenage typecheck",
    "typecheck": "pnpm run engrenage typecheck",
    "typecheck:dist": "pnpm run engrenage typecheck:dist",
    "watch": "pnpm run engrenage vitest:watch"
  },
  "imports": {
    "#bin/*": "./bin/*.ts",
    "#constants": "./src/constants.ts",
    "#entry": "./src/entry.ts",
    "#foundation/*": "./src/foundation/*.ts",
    "#package.json": "./package.json",
    "#project/*": "./src/project/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#src/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts",
    "#tooling/*": "./tooling/*.ts",
    "#tools/*": "./src/tools/*.ts",
    "#types/*": "./src/types/*.ts",
    "#workflows/*": "./src/workflows/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./agents": "./dist/agents.mjs",
    "./agents/claude": "./dist/agents/claude.mjs",
    "./agents/claude/constants": "./dist/agents/claude/constants.mjs",
    "./agents/codex": "./dist/agents/codex.mjs",
    "./agents/codex/constants": "./dist/agents/codex/constants.mjs",
    "./agents/constants": "./dist/agents/constants.mjs",
    "./baseline": "./dist/baseline.mjs",
    "./blocks/internals": "./dist/blocks/internals.mjs",
    "./changesets": "./dist/changesets.mjs",
    "./changesets/constants": "./dist/changesets/constants.mjs",
    "./config": "./dist/config.mjs",
    "./config/constants": "./dist/config/constants.mjs",
    "./constants": "./dist/constants.mjs",
    "./eslint": "./dist/eslint.mjs",
    "./eslint/constants": "./dist/eslint/constants.mjs",
    "./filesystem/internals": "./dist/filesystem/internals.mjs",
    "./format": "./dist/format.mjs",
    "./git": "./dist/git.mjs",
    "./git/constants": "./dist/git/constants.mjs",
    "./github": "./dist/github.mjs",
    "./github/constants": "./dist/github/constants.mjs",
    "./lefthook/constants": "./dist/lefthook/constants.mjs",
    "./options/internals": "./dist/options/internals.mjs",
    "./package": "./dist/package.mjs",
    "./pnpm": "./dist/pnpm.mjs",
    "./pnpm/constants": "./dist/pnpm/constants.mjs",
    "./prettier": "./dist/prettier.mjs",
    "./prettier/constants": "./dist/prettier/constants.mjs",
    "./roles": "./dist/roles.mjs",
    "./tsdown": "./dist/tsdown.mjs",
    "./tsdown/constants": "./dist/tsdown/constants.mjs",
    "./typescript": "./dist/typescript.mjs",
    "./typescript/constants": "./dist/typescript/constants.mjs",
    "./vite": "./dist/vite.mjs",
    "./vitest": "./dist/vitest.mjs",
    "./vitest/constants": "./dist/vitest/constants.mjs",
    "./vscode": "./dist/vscode.mjs",
    "./vscode/constants": "./dist/vscode/constants.mjs",
    "./apis/*": "./data/apis/*.d.ts",
    "./agents/templates/*.md": "./data/agents/templates/*.md",
    "./agents/rules/*.md": "./data/agents/rules/*.md",
    "./agents/sections/*.md": "./data/agents/sections/*.md",
    "./agents/skills/*.md": "./data/agents/skills/*.md",
    "./github/workflows/*.yml": "./data/github/workflows/*.yml",
    "./tsconfig/*.json": "./data/tsconfig/*.json"
  },
  "files": [
    "dist",
    "data",
    "src"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "c12": "4.0.0-rc.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.11.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "exsolve": "^1.1.3",
    "ts-api-utils": "^2.5.0",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@auaust/primitive-kit": "^0.42.2",
    "@auaust/toolkit": "^0.5.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@clack/prompts": "^1.8.1",
    "@commander-js/extra-typings": "^15.0.0",
    "@types/node": "^26.6.5",
    "@types/shell-quote": "^1.7.5",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-istanbul": "^5.0.5",
    "baseline-browser-mapping": "^2.11.34",
    "commander": "~15.0.0",
    "eslint": "^10.13.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "json-schema-to-typescript-lite": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "lefthook": "^2.2.2",
    "node-releases": "^2.0.61",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "shell-quote": "^1.12.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-features": "^3.45.0"
  },
  "peerDependencies": {
    "@changesets/cli": "^3.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "baseline-browser-mapping": "^2.11.0",
    "eslint": "^10.0.0",
    "lefthook": "^2.0.0",
    "node-releases": "^2.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@changesets/cli": {
      "optional": true
    },
    "@vitest/coverage-istanbul": {
      "optional": true
    },
    "lefthook": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "tsx": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@auaust/primitive-kit": "0.42.2",
    "@auaust/toolkit": "0.5.1",
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "fast-string-truncated-width": "3.0.3",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "jsonc-parser": "3.3.1",
    "shell-quote": "1.12.0",
    "sisteransi": "1.0.5"
  },
  "sideEffects": false,
  "prettier": "#tools/prettier/entry",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "restricted"
  }
}
