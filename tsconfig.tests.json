{
  "extends": "./tsconfig.json",
  "include": [
    "tests/**/*.ts",
    "tests/**/*.mts",
    "tests/**/*.cts",
    "global.d.ts"
  ],
  "exclude": ["tests/**/fixtures/**"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.tests.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "incremental": true
  }
}
